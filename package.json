{
  "name": "chksz-musicfree-plugins",
  "version": "1.0.0",
  "description": "ChKSz API MusicFree 音源插件（网易云 / QQ 音乐 / 酷狗）",
  "source": [
    "src/ChKSzNetease.ts",
    "src/ChKSzQQ.ts",
    "src/ChKSzKugou.ts"
  ],
  "main": "dist/ChKSzNetease.js",
  "scripts": {
    "watch": "parcel watch",
    "build": "parcel build && npm run beautify",
    "beautify": "for f in dist/ChKSz*.js; do terser \"$f\" -o \"$f\" --comments false --format beautify; done",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke_chksz.js"
  },
  "keywords": [
    "musicfree",
    "plugin",
    "music",
    "chksz",
    "netease",
    "qqmusic",
    "kugou"
  ],
  "author": {
    "name": "Ohhu",
    "email": "vhhcvuce@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^0.27.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "parcel": "^2.9.3",
    "terser": "^5.37.0",
    "typescript": "^5.1.6"
  },
  "targets": {
    "ChKSzNetease": {
      "source": "src/ChKSzNetease.ts",
      "isLibrary": true,
      "outputFormat": "commonjs",
      "distDir": "dist",
      "includeNodeModules": {
        "axios": false
      }
    },
    "ChKSzQQ": {
      "source": "src/ChKSzQQ.ts",
      "isLibrary": true,
      "outputFormat": "commonjs",
      "distDir": "dist",
      "includeNodeModules": {
        "axios": false
      }
    },
    "ChKSzKugou": {
      "source": "src/ChKSzKugou.ts",
      "isLibrary": true,
      "outputFormat": "commonjs",
      "distDir": "dist",
      "includeNodeModules": {
        "axios": false
      }
    }
  }
}
