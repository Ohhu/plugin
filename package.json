{
  "name": "qqmusic-playlist-importer-plugin",
  "version": "2.1.2",
  "description": "QQ 音乐歌单导入插件 - 仅导入歌单，播放交给 MusicFree 音源重定向",
  "source": "src/index.ts",
  "main": "dist/QQPlaylistImporter.js",
  "scripts": {
    "watch": "parcel watch",
    "build": "parcel build && terser dist/QQPlaylistImporter.js -o dist/QQPlaylistImporter.js --comments false --format beautify"
  },
  "keywords": [
    "musicfree",
    "plugin",
    "music",
    "qqmusic",
    "qq"
  ],
  "author": {
    "name": "Ohhu",
    "email": "vhhcvuce@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^0.27.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "parcel": "^2.9.3",
    "terser": "^5.37.0",
    "typescript": "^5.1.6"
  },
  "target": {
    "main": {
      "includeNodeModules": {
        "axios": false
      }
    }
  }
}
