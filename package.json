{
  "name": "tunehub-musicfree-plugin",
  "version": "1.3.1",
  "description": "TuneHub API 插件 - MusicFree 聚合音乐搜索插件",
  "source": "src/index.ts",
  "main": "dist/Tunehub.js",
  "scripts": {
    "watch": "parcel watch",
    "build": "parcel build && terser dist/Tunehub.js -o dist/Tunehub.js --comments false --format beautify"
  },
  "keywords": [
    "musicfree",
    "plugin",
    "tunehub",
    "music",
    "netease",
    "kuwo",
    "qq"
  ],
  "author": {
    "name": "Ohhu",
    "email": "vhhcvuce@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^0.27.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "parcel": "^2.9.3",
    "terser": "^5.37.0",
    "typescript": "^5.1.6"
  },
  "target": {
    "main": {
      "includeNodeModules": {
        "axios": false
      }
    }
  }
}
