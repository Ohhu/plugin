  "importantDifferencesFromOpenApi": [
    "Proxy base path is /api/proxy/{provider}/..., not /v1/{provider}/...",
    "Proxy auth uses X-API-Key, while the OpenAPI document says Authorization: Bearer <api_key>.",
    "Success code is 200, not code = 0.",
    "Song fields use durationSeconds, publishDate, album.title/cover, and artist string; the OpenAPI schema uses duration, publishTime, album.name/picUrl.",
    "Song URL response nests data.audio and data.song, not a flat SongURL object.",
    "Lyric response nests data.lyric and data.song; lyric includes lrc/qrc/roma/trans.",
    "QQ Music album detail returned only minimal album data and no songs in the tested case.",
    "kugou provider returned 40400 unknown provider on the proxy route."
  ]
}
